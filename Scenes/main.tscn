[node name="Lore" parent="." unique_id=897700427 instance=ExtResource("11_d1ilt")]
lore = Array[String](["The worlds, they didn't know. It came on like a dream. [br] [br] There were many missed. And that's what they had seen.", "Beginning at a time when obedience had won. [br] [br] Where commitment to ourselves was little to none.", "Bringing life into our worlds, again and again. [br] [br] Seeking only a peace that would surely begin.", "For as dimensions unfold, though their existence unknown [br] [br] The Vitamen had arrived so that the planets may thrive", "With them it was a time for collection [br] [br] Engaging our minds in self reflection", "Their solution- pliable, viable, oh-so-desirable", "To take time on a race [br] [br] To set at your own pace"])

