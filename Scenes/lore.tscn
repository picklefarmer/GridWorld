[node name="Lore" type="Node" unique_id=897700427]
script = ExtResource("1_oqjcs")
lore = Array[String](["The worlds, they didn't know. It came on like a dream.  There were many missed. And that's what they had seen.", "Beginning at a time when obedience had won. [br][/br] Where commitment to ourselves was little to none.", "Bringing life into our worlds, again and again. [br] Seeking only a peace that would surely begin.", "For as dimensions unfold, though their existence unknown [br] The Vitamen had arrived so that the planets may thrive", "With them it was a time for collection [br] Engaging our minds in self reflection", "Their solution- pliable, viable, oh-so-desirable", "To take time on a race [br] To set at your own pace"])

